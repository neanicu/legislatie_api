# Environment variables for Legislatie API Client
# Copy this file to .env and adjust values as needed

# SOAP API URL
LEGISLATIE_WSDL_URL=https://legislatie.just.ro/apiws/FreeWebService.svc?wsdl
LEGISLATIE_SOAP_ENDPOINT=https://legislatie.just.ro/apiws/FreeWebService.svc/SOAP

# Scraper settings
LEGISLATIE_BASE_URL=https://legislatie.just.ro
LEGISLATIE_REQUEST_DELAY=1.0
LEGISLATIE_MAX_RETRIES=3

# Cache settings
LEGISLATIE_CACHE_TTL=3600
LEGISLATIE_CACHE_PATH=./.legislatie_cache
LEGISLATIE_USE_PERSISTENT_CACHE=false

# Timeout settings
LEGISLATIE_REQUEST_TIMEOUT=30
LEGISLATIE_SOAP_TIMEOUT=30

# Logging
LEGISLATIE_LOG_LEVEL=INFO
LEGISLATIE_LOG_FILE=./legislatie.log